<?xml version="1.0"?>
<!--
    c3g_cbioportal_instance: ClickHouse users (static, COPY'd to /app/config/ by the Containerfile)
    - One user, cbio_user, used by the webapp, the importer and migrate_db.py.
    - Its password is NEVER written here: it comes from CLICKHOUSE_PASSWORD
      (podman secret, or generated once into /data/config/.ch_password by entrypoint.sh).
    - client_user_profile = cbioportal-docker-compose data/clickhouse_user_settings.xml
-->
<clickhouse>
    <profiles>
        <default/>
        <client_user_profile>
            <max_query_size>1000000000</max_query_size>
            <max_ast_elements>6000000</max_ast_elements>
            <max_expanded_ast_elements>6000000</max_expanded_ast_elements>
        </client_user_profile>
    </profiles>

    <users>
        <cbio_user>
            <password from_env="CLICKHOUSE_PASSWORD"/>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>client_user_profile</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </cbio_user>
    </users>

    <quotas>
        <default/>
    </quotas>
</clickhouse>
